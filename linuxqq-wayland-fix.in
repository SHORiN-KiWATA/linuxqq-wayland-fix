#!/bin/bash
# linuxqq-wayland-fix @VERSION@ —— 修复 Linux QQ 在 Wayland 下的屏幕共享、共享电脑声音、剪贴板和截图闪退。
# https://github.com/SHORiN-KiWATA/linuxqq-wayland-fix
#
#   linuxqq-wayland-fix [QQ 的参数...]   启动 QQ（应用菜单里的「QQ（Wayland修复版）」就是它）
#   linuxqq-wayland-fix --doctor         检查环境与当前 QQ 版本是否兼容
#   linuxqq-wayland-fix --version
#
# 环境变量：
#   QQ_WAYLAND_FIX_QQ         QQ 的启动命令（默认先找 PATH 里的 linuxqq，再找 /opt/QQ/qq）
#   QQ_WAYLAND_FIX_LOG        日志文件（默认 $XDG_RUNTIME_DIR/linuxqq-wayland-fix.log）
#   QQ_WAYLAND_FIX_ANGLE      ANGLE 后端：auto（默认，检测到 Vulkan 时用 vulkan）| vulkan | swiftshader | off
#   QQ_WL_NATIVE_DISABLE=1    关闭屏幕共享修复（排查问题用）
#   QQ_WL_FRAME_REUSE_DISABLE=1 关闭「复用采集纹理」（排查共享时内存增长用）
#   QQ_VOICE_LATENCY_MSEC     语音通话麦克风的录音缓冲毫秒数（默认 30；0 关闭，回到 QQ 原本的 2 秒）
#   QQ_CLIPBOARD_FIX_DISABLE=1 关闭剪贴板修复（排查问题用）
#   QQ_CLIPBOARD_FIX_FORCE=1   强制启用剪贴板修复（KDE 上默认禁用，仅供测试）
#   QQ_SCREENSHOT_FIX_DISABLE=1 关闭截图防闪退（排查问题用）
#   QQ_SCREENSHOT_KDE=0       关闭 KDE 的 KWin ScreenShot2 截图路径（排查问题用）
#   QQ_BORDER_FIX_DISABLE=1   关闭窗口修补（共享边框隐藏、截图覆盖层标题与全屏；排查问题用）

set -u

VERSION="@VERSION@"
LIBDIR="@LIBEXECDIR@"
# 直接从源码树跑（还没 make、也没装包）时，上面两个占位符还没被替换成真值：库路径类检查
# 没法进行，这时明确降级为「跳过」，而不是报一串「找不到 …/libqq-wl-portal.so」的假失败。
# 判据写成 "@*@"：不能写出占位符的字面量 —— Makefile 的替换会把文件里每一处字面量都换掉，
# 那样连上面的 case 模式本身都会被替换成实际值，装好的脚本反而永远判定为「未构建」。
# 同时它也不会把安装路径里合法含 "@" 的情况（自建前缀等）误判成模板 —— 否则「库真的没装」
# 会被一并跳过，而那正是自检要抓的东西。
TEMPLATE_UNBUILT=""
case "$VERSION" in @*@) TEMPLATE_UNBUILT=1 ;; esac
case "$LIBDIR" in @*@) TEMPLATE_UNBUILT=1 ;; esac
SCREENSHARE_LIB="$LIBDIR/libqq-wl-portal.so"
CLIPBOARD_LIB="$LIBDIR/libqq-clipbridge.so"
SCREENSHOT_LIB="$LIBDIR/libqq-screenshot.so"
BORDERFIX_LIB="$LIBDIR/libqq-borderfix.so"
LOG="${QQ_WAYLAND_FIX_LOG:-${XDG_RUNTIME_DIR:-/tmp}/linuxqq-wayland-fix.log}"
QQ_CRASH_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/QQ/crash_files"
CRASH_KEEP="${XDG_CACHE_HOME:-$HOME/.cache}/linuxqq-wayland-fix/crash"

# QQ 崩溃时 Bugly 把调用栈写进 crash_files/tomb_*.txt，但 linuxqq 启动脚本每次都会清空这个目录。
# 启动前把它们复制到缓存目录保存，--doctor 会列出最近的几次。
keep_crash_records() {
    local f
    compgen -G "$QQ_CRASH_DIR/tomb_*.txt" >/dev/null || return 0
    mkdir -p "$CRASH_KEEP" || return 0
    for f in "$QQ_CRASH_DIR"/tomb_*.txt; do
        cp -p "$f" "$CRASH_KEEP/" 2>/dev/null
    done
    ls -1t "$CRASH_KEEP"/tomb_*.txt 2>/dev/null | tail -n +21 | xargs -r rm -f
}

# 优先用 QQ 包自己的 linuxqq 命令（linuxqq 读 qq-flags.conf，linuxqq-appimage 启动 AppImage）。
find_qq() {
    if [[ -n "${QQ_WAYLAND_FIX_QQ:-}" ]]; then
        echo "$QQ_WAYLAND_FIX_QQ"
    elif command -v linuxqq >/dev/null 2>&1; then
        command -v linuxqq
    elif [[ -x /opt/QQ/qq ]]; then
        echo /opt/QQ/qq
    fi
}

# 正在运行的 QQ 主进程（安装版在 /opt/QQ/qq，AppImage 版在挂载目录里，可执行文件都叫 qq）
qq_main_pid() {
    local p cmd
    for p in $(pgrep -f '(^|/)qq( |$)'); do
        cmd=$(tr '\0' ' ' < "/proc/$p/cmdline" 2>/dev/null) || continue
        [[ "$cmd" == *--type=* ]] && continue
        echo "$p"
        return
    done
}

# 运行中 QQ 主进程的可执行文件；QQ 没运行时退回 /opt/QQ/qq。
# AppImage 版的 exe 在挂载目录里（如 /tmp/.mount_XXXX/.../qq）。
qq_runtime_exe() {
    local p exe
    p=$(qq_main_pid)
    if [[ -n "$p" ]]; then
        exe=$(readlink -f "/proc/$p/exe" 2>/dev/null)
        [[ -n "$exe" && -f "$exe" ]] && { echo "$exe"; return 0; }
    fi
    [[ -x /opt/QQ/qq ]] && echo /opt/QQ/qq
}

# 合成器版本（best-effort，拿不到就空）。
compositor_version() {
    local de="${XDG_CURRENT_DESKTOP:-}"
    case "$de" in
        *niri*) niri --version 2>/dev/null | head -1 | cut -d' ' -f1-2 ;;
        *Hyprland*) hyprctl version 2>/dev/null | head -1 | cut -d' ' -f1-2 ;;
        *KDE*) kwin_wayland --version 2>/dev/null | head -1 ;;
        *GNOME*) gnome-shell --version 2>/dev/null | head -1 ;;
    esac
}

# 已安装包的「名 版本」（best-effort，支持 pacman/dpkg/rpm），查不到输出空。
pkg_installed() {
    local p
    for p in "$@"; do
        if command -v pacman >/dev/null 2>&1 && pacman -Q "$p" >/dev/null 2>&1; then
            pacman -Q "$p" 2>/dev/null
            return
        fi
        if command -v dpkg-query >/dev/null 2>&1 && dpkg-query -W "$p" >/dev/null 2>&1; then
            dpkg-query -W -f='${Package} ${Version}\n' "$p" 2>/dev/null
            return
        fi
        if command -v rpm >/dev/null 2>&1 && rpm -q "$p" >/dev/null 2>&1; then
            rpm -q --qf '%{NAME} %{VERSION}-%{RELEASE}\n' "$p" 2>/dev/null
            return
        fi
    done
}

# 文件所属包「名 版本」（best-effort），查不到输出空。
pkg_own() {
    local f="$1" p
    if command -v pacman >/dev/null 2>&1; then
        p=$(pacman -Qoq "$f" 2>/dev/null | head -1)
        [[ -n "$p" ]] && { pacman -Q "$p" 2>/dev/null; return; }
    fi
    if command -v dpkg-query >/dev/null 2>&1; then
        p=$(dpkg -S "$f" 2>/dev/null | head -1 | cut -d: -f1)
        [[ -n "$p" ]] && { dpkg-query -W -f='${Package} ${Version}\n' "$p" 2>/dev/null; return; }
    fi
    if command -v rpm >/dev/null 2>&1; then
        rpm -qf --qf '%{NAME} %{VERSION}-%{RELEASE}\n' "$f" 2>/dev/null
    fi
}

# 已安装的 QQ：包管理器优先（pacman/dpkg/rpm），查不到再退回可执行文件/AppImage。
qq_installed() {
    local out exe
    out=$(pkg_installed linuxqq linuxqq-appimage linuxqq-nt-bwrap)
    if [[ -z "$out" ]]; then
        exe=$(qq_runtime_exe)
        if [[ -n "$exe" ]]; then
            out="手动安装（$exe）"
        elif compgen -G "/opt/linuxqq-appimage/*.AppImage" >/dev/null; then
            out="linuxqq-appimage（未运行）"
        fi
    fi
    echo "$out"
}

# 当前桌面会选中的 portal 后端配置文件（.portal 的 UseIn 匹配 XDG_CURRENT_DESKTOP）。
portal_backend() {
    local de="${XDG_CURRENT_DESKTOP:-}" f d uses
    [[ -n "$de" ]] || return 0
    for f in /usr/share/xdg-desktop-portal/portals/*.portal; do
        [[ -f "$f" ]] || continue
        uses=$(sed -n 's/^UseIn=//p' "$f" | tr ';' '\n')
        for d in ${de//:/ }; do
            grep -qixF "$d" <<< "$uses" && { echo "$f"; return 0; }
        done
    done
}

# portal 接口版本与可用源（best-effort）：如 "ScreenCast v4（显示器、窗口），Screenshot v2"。
portal_interfaces() {
    command -v busctl >/dev/null 2>&1 || return 0
    local base=org.freedesktop.portal.Desktop obj=/org/freedesktop/portal/desktop
    local sc ss types src="" out=""
    sc=$(busctl --user get-property "$base" "$obj" org.freedesktop.portal.ScreenCast version 2>/dev/null | awk '{print $2}')
    ss=$(busctl --user get-property "$base" "$obj" org.freedesktop.portal.Screenshot version 2>/dev/null | awk '{print $2}')
    types=$(busctl --user get-property "$base" "$obj" org.freedesktop.portal.ScreenCast AvailableSourceTypes 2>/dev/null | awk '{print $2}')
    if [[ "$sc" =~ ^[0-9]+$ ]]; then
        out="ScreenCast v$sc"
        if [[ "$types" =~ ^[0-9]+$ ]]; then
            (( types & 1 )) && src="显示器"
            (( types & 2 )) && src="${src:+$src、}窗口"
            (( types & 4 )) && src="${src:+$src、}虚拟屏"
            out+="（${src:-无可用源}）"
        fi
    fi
    [[ "$ss" =~ ^[0-9]+$ ]] && out+="${out:+，}Screenshot v$ss"
    echo "$out"
}

# QQ 的“安装根”（含 resources/app 的目录）：安装版是 /opt/QQ，AppImage 在挂载目录里。
# 从运行中主进程的 exe 向上找；找不到时退回 AppImage 挂载根/exe 所在目录（find 仍能搜到）。
qq_runtime_dir() {
    local exe d i
    exe=$(qq_runtime_exe) || return 1
    d=$(dirname "$exe")
    for i in 1 2 3 4 5; do
        if [[ -e "$d/resources/app" || -e "$d/broadcast-core.so" ]]; then
            echo "$d"
            return 0
        fi
        [[ "$d" == "/" || -z "$d" ]] && break
        d=$(dirname "$d")
    done
    case "$exe" in
        /tmp/.mount_*) echo "$exe" | cut -d/ -f1-3 ;; # AppImage 挂载根
        *) echo "$(dirname "$exe")" ;;
    esac
}

# 系统里有没有可用的 Vulkan 驱动（ICD 声明）。
vulkan_available() {
    local f
    local env_files="${VK_DRIVER_FILES:-${VK_ICD_FILENAMES:-}}"
    if [[ -n "$env_files" ]]; then
        local IFS=':'
        for f in $env_files; do
            [[ -f "$f" ]] && return 0
        done
    fi
    for f in /usr/share/vulkan/icd.d/*.json /etc/vulkan/icd.d/*.json \
             "${XDG_DATA_HOME:-$HOME/.local/share}/vulkan/icd.d"/*.json; do
        [[ -f "$f" ]] && return 0
    done
    return 1
}

# ANGLE 后端：auto（默认，检测到 Vulkan 就用 vulkan）| vulkan | swiftshader | off。
# 部分设备上 Wayland + ANGLE 的 GLES 后端会把屏幕共享画面渲染花，
# 换用 Vulkan 后端可避开；没有 Vulkan 时可以手动选 swiftshader（软件，慢）。
angle_mode() {
    case "${QQ_WAYLAND_FIX_ANGLE:-auto}" in
        auto)
            if vulkan_available; then echo vulkan; else echo none; fi
            ;;
        vulkan | swiftshader) echo "${QQ_WAYLAND_FIX_ANGLE}" ;;
        off | default | none | "") echo none ;;
        *) echo none ;;
    esac
}

# KDE Plasma 自带 XWayland↔Wayland 剪贴板同步（KWin/Klipper），与我们的桥冲突会让 QQ 崩溃，
# 所以 KDE 上默认不预加载剪贴板修复；QQ_CLIPBOARD_FIX_FORCE=1 可强制启用。
clipboard_auto_disabled() {
    [[ -z "${QQ_CLIPBOARD_FIX_FORCE:-}" ]] || return 1
    [[ "${XDG_CURRENT_DESKTOP:-}" == *KDE* || -n "${KDE_FULL_SESSION:-}" ]]
}

clipboard_state() {
    if clipboard_auto_disabled; then
        echo "off(kde)"
    elif [[ -n "${QQ_CLIPBOARD_FIX_DISABLE:-}" && "${QQ_CLIPBOARD_FIX_DISABLE}" != 0 ]]; then
        echo off
    else
        echo on
    fi
}

# 当前生效的 QQ 版本目录：热更新版本优先，否则用安装目录。
qq_version_dir() {
    local cfg="${XDG_CONFIG_HOME:-$HOME/.config}/QQ/versions" cur=""
    if [[ -f "$cfg/config.json" ]]; then
        cur=$(sed -n 's/.*"curVersion"[^"]*"\([^"]*\)".*/\1/p' "$cfg/config.json" | head -1)
    fi
    if [[ -n "$cur" && -d "$cfg/$cur" ]]; then
        echo "$cfg/$cur"
    elif [[ -d /opt/QQ/resources/app ]]; then
        echo /opt/QQ/resources/app
    fi
}

# qq-screenshot-helper.desktop 的位置：门户（GNOME）和 KWin（KDE）都靠它认调用者。
# 先按 XDG_DATA_DIRS 找（与桌面环境的查找方式一致），再看本包的安装前缀
# （$LIBDIR 往上两级，如 /usr/lib/<name> -> /usr、Nix 的 store 路径）。
screenshot_helper_desktop() {
    local d
    for d in ${XDG_DATA_DIRS:-/usr/local/share:/usr/share} /usr/share \
             "$(dirname "$(dirname "$LIBDIR")")/share"; do
        if [[ -r "$d/applications/qq-screenshot-helper.desktop" ]]; then
            echo "$d/applications/qq-screenshot-helper.desktop"
            return 0
        fi
    done
    return 1
}

# 音频图：有线和蓝牙输出同时在线时，WirePlumber 会在两者之间切换默认设备，
# PipeWire 随之重建整个图，采集/通话客户端手里的 node 句柄失效 —— 共享会突然没画面，
# 通话也可能挂不断。
#
# 蓝牙单独在线时同样会断：通话（用麦）会把蓝牙从 A2DP 切到 HFP，PipeWire 一样重建图。
# 当前档位可以读出来 —— wpctl inspect 的 api.bluez5.profile：a2dp-sink 是听歌档，
# headset-head-unit / 带 hfp 的是通话档，后者正处在"一用麦就重建图"的路径上。
# 输出：有线数 蓝牙数 蓝牙档位（读不到就是空串）
# 统计"在线"的音频输出。
#
# 只认真正在 PipeWire 图里的 sink：先取 wpctl status 里所有 id，再对每个 id 跑
# wpctl inspect，用 media.class = "Audio/Sink" + node.name 前缀（alsa_output. /
# bluez_output.）判定。不能直接 grep wpctl status 的输出：末尾的
# "Default Configured Devices" 会把 WirePlumber 记住的默认设备（比如以前配过的
# 蓝牙耳机）也数进来，而在线 sink 在 wpctl status 里显示的是描述文字、不是 node.name。
audio_graph_outputs() {
    command -v wpctl >/dev/null 2>&1 || return 1
    local st
    st=$(wpctl status 2>/dev/null) || return 1
    local wired=0 bt=0 prof="" id info
    while read -r id; do
        [[ -n "$id" ]] || continue
        info=$(wpctl inspect "$id" 2>/dev/null) || continue
        case "$info" in
        *'media.class = "Audio/Sink"'*) ;;
        *) continue ;;
        esac
        case "$info" in
        *'node.name = "alsa_output.'*) wired=$((wired + 1)) ;;
        *'node.name = "bluez_output.'*)
            bt=$((bt + 1))
            if [[ -z "$prof" ]]; then
                prof=$(printf '%s\n' "$info" | grep 'api.bluez5.profile' | head -1 | sed 's/.*= *//; s/"//g')
            fi
            ;;
        esac
    done < <(printf '%s\n' "$st" | grep -oE '^[^0-9]*[0-9]+\.' | grep -oE '[0-9]+')
    printf '%s %s %s\n' "$wired" "$bt" "$prof"
}

# ---- 采集与内存：合成器能力、帧率是否真的生效、谁在占共享内存 ---------------
# /proc/meminfo 的 Shmem（普通共享内存 + GPU 侧 system 记账的总和），单位 KiB
shmem_kib() { awk '/^Shmem:/{print $2+0; exit}' /proc/meminfo 2>/dev/null; }

# journal 里最近一次真实协商到的帧率，返回「epoch 帧率」。帧率要匹配第一个
# `framerate:` 片段：整行里还有 pixel_aspect_ratio 等别的 num:，贪心匹配会取错。
last_negotiated_fps() {
    command -v journalctl >/dev/null 2>&1 || return 0
    local line ep rate
    line=$(journalctl --user -u niri.service --since '-30min' --no-pager -o short-unix 2>/dev/null |
        grep 'framerate: spa_fraction { num:' | tail -1)
    [[ -n "${line:-}" ]] || return 0
    ep=${line%% *}
    local frac num den
    frac=$(printf '%s' "$line" | grep -oE '(^|[^_])framerate: spa_fraction \{ num: [0-9]+, denom: [0-9]+' |
        head -1)
    num=$(printf '%s' "$frac" | grep -oE 'num: [0-9]+' | head -1 | grep -oE '[0-9]+')
    den=$(printf '%s' "$frac" | grep -oE 'denom: [0-9]+' | head -1 | grep -oE '[0-9]+')
    if [[ -n "${num:-}" && -n "${den:-}" && "${den:-0}" != 0 ]]; then
        rate=$(((num + den / 2) / den))    # 24/1→24，24000/1001→24
    fi
    printf '%s %s\n' "${ep%%.*}" "${rate:-0}"
}

# 合成器启动时刻（epoch），用来判断 journal 里的协商记录是不是本次启动之后的。
compositor_start_epoch() {
    local ts p
    if command -v systemctl >/dev/null 2>&1; then
        # LC_ALL=C: systemd 按 locale 格式化时间戳，中文 locale 下 date -d 解析不了
        ts=$(LC_ALL=C systemctl --user show niri.service -p ActiveEnterTimestamp --value 2>/dev/null)
        if [[ -n "${ts:-}" && "$ts" != "n/a" ]]; then
            LC_ALL=C date -d "$ts" +%s 2>/dev/null && return 0
        fi
    fi
    p=$(pgrep -x niri 2>/dev/null | head -1)
    [[ -n "${p:-}" ]] && stat -c %Y "/proc/$p" 2>/dev/null
    return 0
}

doctor() {
    local ok=0 warn=0 fail=0 skipped=0
    pass() { printf '  \e[32m✓\e[0m %s\n' "$*"; ok=$((ok + 1)); }
    note() { printf '  \e[33m!\e[0m %s\n' "$*"; warn=$((warn + 1)); }
    bad()  { printf '  \e[31m✗\e[0m %s\n' "$*"; fail=$((fail + 1)); }
    skip() { printf '  \e[2m-\e[0m %s\n' "$*"; skipped=$((skipped + 1)); }

    if [[ -n "$TEMPLATE_UNBUILT" ]]; then
        echo "linuxqq-wayland-fix （未构建模板）自检"
        note "这是源码树里的模板（版本/库路径占位符未替换）：依赖安装路径的检查标为跳过；完整自检请按 README 构建或装包后再跑"
    else
        echo "linuxqq-wayland-fix $VERSION 自检"
    fi
    echo
    echo "[基础]"
    local qq; qq=$(find_qq)
    [[ -n "$qq" ]] && pass "QQ 启动方式: $qq" || bad "找不到 QQ（linuxqq 或 /opt/QQ/qq），可用 QQ_WAYLAND_FIX_QQ 指定"
    local qqinst; qqinst=$(qq_installed)
    if [[ -n "$qqinst" ]]; then
        pass "QQ 安装: $qqinst"
    else
        note "未检测到已安装的 linuxqq / linuxqq-appimage 包（可能手动安装）"
    fi
    if [[ -n "$TEMPLATE_UNBUILT" ]]; then
        skip "屏幕共享修复 / 剪贴板修复 / 截图防闪退 / 窗口修补: 跳过（未构建模板，库路径未替换）"
    else
        [[ -r "$SCREENSHARE_LIB" ]] && pass "屏幕共享修复: $SCREENSHARE_LIB" || bad "找不到 $SCREENSHARE_LIB"
        if clipboard_auto_disabled; then
            note "剪贴板修复: KDE 默认禁用（Plasma 自带同步，QQ 剪贴板照常可用；QQ_CLIPBOARD_FIX_FORCE=1 强制启用）"
        elif [[ -r "$CLIPBOARD_LIB" ]]; then
            pass "剪贴板修复: $CLIPBOARD_LIB"
        else
            bad "找不到 $CLIPBOARD_LIB"
        fi
        [[ -r "$SCREENSHOT_LIB" ]] && pass "截图防闪退: $SCREENSHOT_LIB" || bad "找不到 $SCREENSHOT_LIB"
        # 截图链（GNOME）：没有 wlr-screencopy，靠 helper 走门户。库里没有门户分支（0.2.10 之前的包）
        # 或 helper 缺失时，截图会静默地全黑，日志里才有原因。KDE 走 KWin ScreenShot2，在后面单独检查。
        if [[ "${XDG_CURRENT_DESKTOP:-}" == *GNOME* ]]; then
            local sh_help="$LIBDIR/qq-screenshot-helper" sh_desk
            if [[ -r "$SCREENSHOT_LIB" ]]; then
                # 标记用门户路径的开关名：真正发起门户调用的是 helper 进程，库里没有 D-Bus 接口串。
                # 实测：含门户路径的版本有这个串，0.2.10 之前的没有。
                if grep -aq 'QQ_SCREENSHOT_PORTAL' "$SCREENSHOT_LIB"; then
                    pass "截图: libqq-screenshot.so 含 GNOME 门户分支"
                else
                    bad "截图: 这份 libqq-screenshot.so 没有 GNOME 门户分支（0.2.10 之前的版本），截图会全黑，请升级本包"
                fi
            fi
            [[ -x "$sh_help" ]] && pass "截图: helper 已安装（$sh_help）" \
                || bad "截图: 缺 qq-screenshot-helper，截图会全黑（重装本包或 make install）"
            if sh_desk=$(screenshot_helper_desktop); then
                pass "截图: helper 的 .desktop 已安装（$sh_desk）"
            else
                note "截图: 缺 qq-screenshot-helper.desktop（门户用它认调用者）"
            fi
        fi
        [[ -r "$BORDERFIX_LIB" ]] && pass "窗口修补（共享边框/截图覆盖层）: $BORDERFIX_LIB" || note "找不到 $BORDERFIX_LIB（共享边框会变成窗口、截图覆盖层不平铺）"
    fi
    [[ -n "${WAYLAND_DISPLAY:-}" ]] && pass "Wayland 会话: $WAYLAND_DISPLAY" || note "WAYLAND_DISPLAY 为空，不在 Wayland 会话里？"
    [[ -n "${DISPLAY:-}" ]] && pass "XWayland: $DISPLAY" || bad "DISPLAY 为空：QQ 的界面与剪贴板仍需要 XWayland"
    case "$(angle_mode)" in
        vulkan) pass "ANGLE 后端: vulkan（检测到 Vulkan，可规避观看共享花屏）" ;;
        swiftshader) note "ANGLE 后端: swiftshader（软件渲染，较慢，由 QQ_WAYLAND_FIX_ANGLE 指定）" ;;
        none) note "ANGLE 后端: 默认；若观看共享花屏，可设 QQ_WAYLAND_FIX_ANGLE=swiftshader（较慢）或改用 X11，见 docs/原理详解.md#附观看共享花屏" ;;
    esac

    echo
    echo "[音频图（蓝牙耳机 / 共享突然无画面 / 挂不断）]"
    local ag
    if command -v wpctl >/dev/null 2>&1 && ag=$(audio_graph_outputs); then
        local wired bt prof rest
        wired="${ag%% *}"
        rest="${ag#* }"
        bt="${rest%% *}"
        prof="${rest#* }"
        if [[ "$wired" -eq 0 && "$bt" -eq 0 ]]; then
            note "没检测到在线的音频输出（声卡未就绪或都被禁用了）"
        elif [[ "$wired" -gt 0 && "$bt" -gt 0 ]]; then
            note "有线和蓝牙音频输出同时在线（有线=$wired 蓝牙=$bt）：WirePlumber 会换默认设备、PipeWire 重建图，共享会突然无画面、通话可能挂不断"
            echo "      断开其中一个，或 wpctl set-default <输出 id> 钉住默认设备；已经卡住时 systemctl --user restart pipewire wireplumber"
        elif [[ "$prof" == *headset* || "$prof" == *hfp* ]]; then
            note "蓝牙输出当前在通话档（api.bluez5.profile=$prof）：通话/用麦会让 PipeWire 重建图，共享会突然无画面、通话可能挂不断"
            echo "      通话期间别用耳机麦（或让它只留 A2DP 档）；已经卡住时 systemctl --user restart pipewire wireplumber"
        elif [[ -n "$prof" ]]; then
            pass "音频图: 有线=$wired 蓝牙=$bt（蓝牙档位 $prof，听歌档；通话切到 HFP 时会重建图）"
        elif [[ "$bt" -eq 0 && "$wired" -gt 1 ]]; then
            pass "音频输出: 没有蓝牙输出在线（有线=$wired 个，都在线）"
        else
            pass "音频输出: 只有一种在线（有线=$wired 蓝牙=$bt）"
        fi
    else
        note "没有 wpctl，跳过音频图检查"
    fi

    echo "[QQ 内部实现（QQ 更新后用来判断修复是否还适用）]"
    local vdir rdir bc av wrapper
    vdir=$(qq_version_dir)
    rdir=$(qq_runtime_dir)
    local roots=()
    [[ -n "$vdir" ]] && roots+=("$vdir")
    [[ -n "$rdir" ]] && roots+=("$rdir")
    roots+=(/opt/QQ)
    bc=$(find "${roots[@]}" -name broadcast-core.so -print -quit 2>/dev/null)
    av=$(find "${roots[@]}" -name libAVSDKPlugin.so -print -quit 2>/dev/null)
    local wrapper_candidates=()
    [[ -n "$vdir" ]] && wrapper_candidates+=("$vdir/wrapper.node")
    if [[ -n "$rdir" ]]; then
        wrapper_candidates+=("$rdir/wrapper.node" "$rdir/resources/app/wrapper.node")
    fi
    wrapper_candidates+=(/opt/QQ/resources/app/wrapper.node)
    wrapper=$(ls "${wrapper_candidates[@]}" 2>/dev/null | head -1)
    if [[ -z "$bc" ]]; then
        if [[ -z "$rdir" && -e /opt/linuxqq-appimage ]]; then
            note "找不到 broadcast-core.so：AppImage 需要 QQ 运行中才能检查内部实现（启动 QQ 后再运行 --doctor）"
        else
            bad "找不到 broadcast-core.so（QQ 版本目录: ${vdir:-?}）"
        fi
    else
        grep -aq MonitorCapture_WaylandProc "$bc" \
            && pass "屏幕共享：存在 Wayland 采集线程" \
            || bad "屏幕共享：没有 MonitorCapture_WaylandProc，QQ 改了采集实现"
        grep -aq XDG_SESSION_TYPE "$bc" \
            && pass "屏幕共享：仍用 XDG_SESSION_TYPE 判断 Wayland" \
            || bad "屏幕共享：broadcast-core 不再读 XDG_SESSION_TYPE"
        local f
        for f in pw_context_connect_fd pw_stream_connect pw_core_disconnect pw_stream_dequeue_buffer; do
            grep -aq "$f" "$bc" || bad "屏幕共享：找不到 $f"
        done
        grep -aq pa_context_get_sink_info_by_name "$bc" \
            && pass "共享电脑声音：仍通过 pa_context_get_sink_info_by_name 查询格式" \
            || note "共享电脑声音：查询方式变了，可能无声"
    fi
    # 窗口几何为空时的崩溃检查（见 qq-wl-portal.c「6.」）：特征码必须恰好出现一次
    local qqbin offs
    qqbin=$(qq_runtime_exe)
    if [[ -f "$qqbin" ]]; then
        offs=$(LC_ALL=C grep -obaF $'\x44\x8b\x7e\x08\x45\x85\xff\x74' "$qqbin" 2>/dev/null | cut -d: -f1)
        if [[ "$offs" =~ ^[0-9]+$ ]] &&
           [[ $(od -An -tx1 -j $((offs + 9)) -N 8 "$qqbin" | tr -d ' \n') == 448b660c4585e474 ]]; then
            pass "共享时防闪退：找到窗口几何检查"
        else
            note "共享时防闪退：QQ 改了实现，显示器坐标不从 0 开始时共享可能闪退（issue #1）"
        fi
    fi
    if [[ -z "$wrapper" ]]; then
        note "找不到 wrapper.node，跳过剪贴板检查"
    elif grep -aq XSetSelectionOwner "$wrapper"; then
        pass "剪贴板：QQ 仍是 X11 实现"
    else
        bad "剪贴板：wrapper.node 不再使用 XSetSelectionOwner，QQ 改了剪贴板实现"
    fi

    echo
    echo "[桌面环境]"
    local de="${XDG_CURRENT_DESKTOP:-}" st="${XDG_SESSION_TYPE:-未知}" cv
    cv=$(compositor_version)
    if [[ -z "$de" ]]; then
        note "桌面环境: 无法识别（XDG_CURRENT_DESKTOP 为空，$st）"
    elif [[ -n "$cv" ]]; then
        pass "桌面环境: $de（$st, $cv）"
    else
        pass "桌面环境: $de（$st）"
    fi
    if command -v busctl >/dev/null 2>&1; then
        local psvc pfile pdbus pown pstate pdesc piface ptypes
        psvc=$(pkg_installed xdg-desktop-portal)
        piface=$(portal_interfaces)
        if [[ -n "$piface" ]]; then
            pfile=$(portal_backend)
            pdesc=""
            if [[ -n "$pfile" ]]; then
                pdbus=$(sed -n 's/^DBusName=\(org\.freedesktop\.impl\.portal\..*\)$/\1/p' "$pfile" | head -1)
                pown=$(pkg_own "$pfile")
                if [[ -n "$pdbus" ]] && busctl --user list 2>/dev/null | grep -F "$pdbus" | grep -q activatable; then
                    pstate="按需启动"
                elif [[ -n "$pdbus" ]] && busctl --user list 2>/dev/null | grep -qF "$pdbus"; then
                    pstate="运行中"
                else
                    pstate="未运行"
                fi
                pdesc="，后端 $(basename "$pfile")（${pown:+$pown，}$pstate）"
                if [[ "$pstate" == "未运行" ]]; then
                    note "Portal: ${psvc:-xdg-desktop-portal} 运行中$pdesc"
                else
                    pass "Portal: ${psvc:-xdg-desktop-portal} 运行中$pdesc"
                fi
            elif [[ "$piface" == *ScreenCast* ]]; then
                # 没有 UseIn 匹配当前桌面的后端配置，不等于共享不可用：接口由默认后端
                # （-wlr/-gtk 等）提供时 D-Bus 上照样能用，niri 就是这种。
                pass "Portal: ${psvc:-xdg-desktop-portal} 运行中（无匹配「${XDG_CURRENT_DESKTOP}」的后端配置，ScreenCast 由默认后端提供）"
            elif [[ -n "${XDG_CURRENT_DESKTOP:-}" ]]; then
                note "Portal: ${psvc:-xdg-desktop-portal} 运行中（未找到匹配「${XDG_CURRENT_DESKTOP}」的后端配置，屏幕共享可能不可用）"
            else
                pass "Portal: ${psvc:-xdg-desktop-portal} 运行中"
            fi
            pass "Portal 接口: $piface"
        else
            bad "Portal: xdg-desktop-portal 不可用（屏幕共享、GNOME 截图修复将无法工作）"
        fi
        ptypes=$(busctl --user get-property org.freedesktop.portal.Desktop /org/freedesktop/portal/desktop \
                org.freedesktop.portal.ScreenCast AvailableSourceTypes 2>/dev/null | awk '{print $2}')
        [[ -n "$ptypes" && "$ptypes" != 0 ]] && pass "屏幕共享：portal 录屏可用" \
            || bad "屏幕共享：xdg-desktop-portal 没有可用的 ScreenCast 实现"
    else
        note "没有 busctl，跳过 portal 检查"
    fi
    if clipboard_auto_disabled; then
        note "剪贴板：KDE Plasma 自带 XWayland 剪贴板同步，本修复已默认禁用（QQ 剪贴板照常可用）"
    elif command -v wayland-info >/dev/null 2>&1; then
        local wi; wi=$(timeout 15 wayland-info 2>/dev/null)
        if [[ -z "$wi" ]]; then
            note "wayland-info 没有返回接口列表（合成器无响应或环境异常），跳过剪贴板协议检查"
        elif grep -q ext_data_control_manager_v1 <<< "$wi"; then
            pass "剪贴板：合成器支持 ext-data-control"
        elif grep -q zwlr_data_control_manager_v1 <<< "$wi"; then
            pass "剪贴板：合成器支持 wlr-data-control"
        else
            bad "剪贴板：合成器不支持 data-control（GNOME 即是如此），剪贴板修复无法工作"
        fi
    else
        note "没有 wayland-info，跳过剪贴板协议检查（安装 wayland-utils 可检查）"
    fi
    # 剪贴板桥靠 libXRes（运行时 dlopen）认出合成器的 X11 剪贴板代理窗口；缺了它会静默退化，
    # 外部复制的内容不再经桥接交给 QQ。NixOS 不用 ld.so.cache，跳过。
    if ! clipboard_auto_disabled && [[ ! -e /etc/NIXOS ]] && command -v ldconfig >/dev/null 2>&1 \
            && ! ldconfig -p 2>/dev/null | grep -q 'libXRes\.so\.1'; then
        bad "剪贴板：缺少 libXRes（Arch: libxres，Debian/Ubuntu: libxres1，Fedora: libXres），认不出合成器的剪贴板代理"
    fi
    if [[ "${XDG_CURRENT_DESKTOP:-}" == *KDE* ]]; then
        local kde_helper="$LIBDIR/qq-screenshot-helper" kde_desktop
        kde_desktop=$(screenshot_helper_desktop)
        if [[ ! -x "$kde_helper" ]]; then
            note "截图：缺 $kde_helper（KDE 下截图会是黑图，重装本包）"
        elif [[ -z "$kde_desktop" ]]; then
            note "截图：找不到 qq-screenshot-helper.desktop，KWin 的权限检查会拒绝 ScreenShot2（重装本包）"
        elif ! grep -q '^X-KDE-DBUS-Restricted-Interfaces=org\.kde\.KWin\.ScreenShot2$' "$kde_desktop"; then
            note "截图：$kde_desktop 的受限接口声明格式不对（不能带结尾分号），KWin 会拒绝 ScreenShot2"
        elif command -v busctl >/dev/null 2>&1 && ! busctl --user status org.kde.KWin.ScreenShot2 >/dev/null 2>&1; then
            note "截图：找不到 org.kde.KWin.ScreenShot2 服务（KWin 版本过旧？）"
        else
            pass "截图：KDE ScreenShot2（helper + 权限声明）已就绪"
        fi
    fi
    # Easy Effects 的排除名单在 [StreamInputs] / [StreamOutputs] 的 blocklist=（逗号分隔）。
    # 提到 TRAE 但键不是 blocklist 的行（如 exclude=）Easy Effects 不读，单独指出来，免得用户以为配过了。
    local ee res missing wrong
    for ee in "$HOME/.var/app/com.github.wwmm.easyeffects/config/easyeffects/db/easyeffectsrc" \
              "${XDG_CONFIG_HOME:-$HOME/.config}/easyeffects/db/easyeffectsrc"; do
        [[ -f "$ee" ]] || continue
        res=$(awk -F= '
            /^\[/ { sec = $0; next }
            sec != "[StreamInputs]" && sec != "[StreamOutputs]" { next }
            $1 == "blocklist" {
                n = split(substr($0, length($1) + 2), a, ",")
                for (i = 1; i <= n; i++) if (a[i] == "TRAE") ok[sec] = 1
                next
            }
            /TRAE/ { print "wrong " $1 }
            END {
                if (!ok["[StreamInputs]"]) print "missing 输入"
                if (!ok["[StreamOutputs]"]) print "missing 输出"
            }' "$ee")
        wrong=$(awk '$1 == "wrong" { print $2 "=" }' <<<"$res" | sort -u | paste -sd' ')
        missing=$(awk '$1 == "missing" { printf "「%s」", $2 }' <<<"$res")
        if [[ -n "$wrong" ]]; then
            note "Easy Effects 配置里有 $wrong 写着 TRAE，但 Easy Effects 不读这个键，不会生效；排除名单的键是 blocklist=，请在界面里添加，或删掉这些行（$ee）"
        fi
        if [[ -n "$missing" ]]; then
            note "检测到 Easy Effects：请在$missing的排除名单里加上 TRAE，否则 QQ 一开通话/共享就会崩（$ee）"
        else
            pass "Easy Effects 已排除 QQ（TRAE）"
        fi
    done
    if systemctl --user is-active -q linuxqq-clipsync 2>/dev/null || pgrep -f "(^|/)linuxqq-clipsync( |$)" >/dev/null; then
        note "linuxqq-clipsync 正在运行：本工具已包含剪贴板修复，同时运行会重复同步。请停用：systemctl --user disable --now linuxqq-clipsync"
    fi

    echo
    echo "[合成器能力（采集走哪条路）]"
    # 合成器可以不宣告能力位：portal 后端读 AvailableSourceTypes/AvailableCursorModes，
    # 读到 0 就拒绝每一次 SelectSources。表现是选择框里只有「整个屏幕」，或者直接失败。
    case "${XDG_CURRENT_DESKTOP:-}" in
    *niri*)
        if command -v pacman >/dev/null 2>&1 && pacman -Qo /usr/bin/niri 2>/dev/null | grep -q 'niri-portal-cast'; then
            pass "niri 来自 niri-portal-cast（带能力宣告与限帧率补丁）"
        elif command -v pacman >/dev/null 2>&1 && pacman -Qo /usr/bin/niri >/dev/null 2>&1; then
            note "/usr/bin/niri 不是 niri-portal-cast：原版 niri 不宣告 AvailableSourceTypes，portal 会拒绝所有 SelectSources（选择框里只剩「整个屏幕」）"
        else
            skip "niri 二进制来自哪个包无法判断（没有 pacman），跳过能力宣告检查"
        fi
        ;;
    *)
        skip "合成器不是 niri（${XDG_CURRENT_DESKTOP:-未知}），跳过 niri 专属的能力宣告检查"
        ;;
    esac
    # 直接问合成器它宣告了哪些全局接口：查 /usr/share/wayland-protocols 只能证明
    # 协议定义装了，和这个合成器实不实现是两件事。
    wl_globals=""
    if command -v wayland-info >/dev/null 2>&1 && command -v timeout >/dev/null 2>&1; then
        wl_globals=$(timeout 15 wayland-info 2>/dev/null | grep -oE "^interface: '[^']+'" | sed "s/interface: '//; s/'//")
    fi
    if [[ -z "$wl_globals" ]]; then
        note "拿不到合成器全局接口列表（没装 wayland-utils，或合成器没响应），跳过协议探测"
    else
        pass "合成器宣告了 $(printf '%s\n' "$wl_globals" | wc -l) 个全局接口"
        # 有没有导出类协议只是「前提」，不能据此断言采集走不走零拷贝：本机就同时
        # 宣告了 zwp_linux_dmabuf_v1 与 ext_image_copy_capture_manager_v1。真正作数
        # 的是 portal/PipeWire 的格式协商，niri 会把它写进 journal。
        if printf '%s\n' "$wl_globals" | grep -qE '^(zwlr_export_dmabuf_manager_v1|zwlr_screencopy_manager_v1|ext_image_copy_capture_manager_v1)$'; then
            pass "合成器有导出/图像拷贝类采集协议（具备零拷贝采集的前提）"
        else
            note "合成器没有导出/图像拷贝类采集协议，零拷贝采集的前提不成立"
        fi
        if [[ "${XDG_CURRENT_DESKTOP:-}" == *niri* ]] && command -v journalctl >/dev/null 2>&1 &&
            journalctl --user -u niri.service --since '-30min' --no-pager 2>/dev/null | grep -q 'negotiated inefficient shm stream'; then
            note "实测协商走 SHM 拷贝（journal：negotiated inefficient shm stream）：共享占用记在系统内存（Shmem）里"
        fi
    fi

    echo
    echo "[采集流与内存（共享时才有意义）]"
    # 「配置里写了」和「真的在推流」是两件事：只读配置会把没生效的值报成正常。
    local live_line live_epoch live_rate start_at vstreams=0
    live_line=$(last_negotiated_fps)
    live_epoch=${live_line%% *}
    live_rate=${live_line##* }
    # 只有一个字段说明解析异常，宁可不用
    [[ "$live_line" == "$live_epoch" ]] && live_rate=""
    start_at=$(compositor_start_epoch)
    if [[ -n "${live_rate:-}" && -n "${start_at:-}" ]] && (( ${live_epoch:-0} < start_at )); then
        note "journal 里最近一次协商 ${live_rate} Hz 早于本次合成器启动，不作为现行值"
        live_rate=""
    fi
    if command -v wpctl >/dev/null 2>&1; then
        vstreams=$(wpctl status 2>/dev/null | grep -c 'Stream/Output/Video')
        if ((vstreams > 0)); then
            pass "当前有 $vstreams 路视频采集流"
        else
            note "当前没有视频采集流（共享时再跑一次 --doctor）"
        fi
    fi
    if [[ -n "${live_rate:-}" ]]; then
        pass "最近一次实际协商到的帧率 ${live_rate} Hz"
    fi
    # 采集请求 / 成功出流：只数真正到达 Streaming 的会话（成功的 shm 协商不打印
    # "negotiated"，拿它当判据会把正常会话算成失败）。
    if [[ "${XDG_CURRENT_DESKTOP:-}" == *niri* ]] && command -v journalctl >/dev/null 2>&1; then
        local jl rm_count stream_count
        jl=$(journalctl --user -u niri.service --since '-30min' --no-pager 2>/dev/null)
        rm_count=$(printf '%s\n' "$jl" | grep -c 'record_monitor')
        stream_count=$(printf '%s\n' "$jl" | grep -c 'Paused -> Streaming')
        if ((rm_count == 0)); then
            note "最近 30 分钟没有任何采集请求（niri 没被叫到：问题在门口的选择框或客户端本身）"
        elif ((stream_count == 0)); then
            note "有 $rm_count 次采集请求，0 次出流：客户端要了屏幕，在协商格式之前就放弃了（常见原因是选择框被关掉，或音频设备切换把 PipeWire 图拆了）"
        else
            pass "$rm_count 次请求，$stream_count 次成功出流"
        fi
    fi
    if [[ -r /proc/meminfo ]]; then
        local s1 s2 rate shmem_gib
        s1=$(shmem_kib)
        shmem_gib=$(awk '/^Shmem:/{printf "%.2f", $2/1048576}' /proc/meminfo)
        if ((vstreams > 0)); then
            printf '       正在采样 2 秒算增长速率…\n'
            sleep 2
            s2=$(shmem_kib)
            rate=$(((s2 - s1) / 2048))    # KiB / 2 秒 → MiB/s
            ((rate < 0)) && rate=0
            # 归属（谁占的内存）要读几百个 /proc 条目、单次多花约 8 秒，留到后续 PR
            if ((rate > 100)); then
                bad "共享内存正以 ${rate} MB/s 增长（Shmem ${shmem_gib} GiB），几十秒就会吃光内存"
                printf '       先降档：niri 用户可在配置的 screencasting 块里限帧率/分辨率，改完重开一次共享\n'
            elif ((rate >= 20)); then
                note "共享内存以 ${rate} MB/s 增长（Shmem ${shmem_gib} GiB）"
                printf '       降帧率/分辨率；注意 i915 的 GEM 是 shmem 记账的，但不进任何进程的\n'
                printf '       smaps，所以「进程 Pss_Shmem 很小、Shmem 却在涨」是正常的。\n'
            else
                pass "共享内存稳定（2 秒内约 ${rate} MB/s，Shmem ${shmem_gib} GiB）"
            fi
        else
            pass "Shmem ${shmem_gib} GiB（当前没有采集流，增长速率与归属要共享时才能测）"
        fi
    fi

    echo
    echo "[shmem 大页策略]"
    # 命令行里写了不等于内核认：有些内核对 transparent_hugepage=shmem:xxx 直接
    # "cannot parse, ignored"，只在 dmesg 里说一句，sysfs 仍是默认值。所以比对实际策略。
    if [[ -r /sys/kernel/mm/transparent_hugepage/shmem_enabled ]]; then
        local shmem_hp shmem_thp cmd_thp want_thp
        shmem_hp=$(awk '/^ShmemHugePages:/{printf "%.2f", $2/1048576}' /proc/meminfo 2>/dev/null)
        shmem_thp=$(sed 's/.*\[\([a-z_]*\)\].*/\1/' /sys/kernel/mm/transparent_hugepage/shmem_enabled)
        cmd_thp=$(tr ' ' '\n' < /proc/cmdline 2>/dev/null | grep -m1 '^transparent_hugepage=.*shmem' || true)
        if [[ -n "${cmd_thp:-}" ]]; then
            want_thp=${cmd_thp##*:}
            if [[ "$want_thp" == "$shmem_thp" ]]; then
                pass "shmem 大页策略 $shmem_thp（与内核命令行 $cmd_thp 一致）"
            else
                note "内核命令行写着 $cmd_thp，实际策略是 $shmem_thp —— 这个参数被内核丢掉了"
                printf '       被丢掉的参数不会报错，只在 dmesg 里留一行 "transparent_hugepage= cannot parse, ignored"（读 dmesg 需要权限）。\n'
                printf '       要真的改掉，开机后写 sysfs，例如放 /etc/tmpfiles.d/thp-shmem.conf：\n'
                printf '       w /sys/kernel/mm/transparent_hugepage/shmem_enabled - - - - never\n'
            fi
        else
            note "shmem 大页策略 $shmem_thp（内核命令行没设置，用默认值；大页 ${shmem_hp:-?} GiB）"
        fi
    else
        skip "没有 shmem_enabled，跳过大页策略检查"
    fi

    echo
    echo "[正在运行的 QQ]"
    local pid
    pid=$(qq_main_pid)
    if [[ -z "$pid" ]]; then
        pass "QQ 未运行"
    elif tr '\0' '\n' < "/proc/$pid/environ" 2>/dev/null | grep -q 'libqq-wl-portal.so'; then
        pass "QQ（PID $pid）已注入"
    else
        bad "QQ（PID $pid）没有注入：请完全退出 QQ（含托盘），再从「QQ（Wayland修复版）」打开"
    fi
    # 逐进程审计：真正收帧的是 --type=ppapi 那个进程，它没被注入就等于没修。
    # 判据是「四个库缺哪个」，不是数够四个：进程里可能还注入了别的 libqq-*.so
    # （例如实验用的 libqq-nvenc.so），数个数会把缺库误判成齐全。
    # 其它子进程按需注入，缺库不一定致命，所以只列前两条异常的，其余合计。
    if [[ -n "$pid" ]]; then
        local qqpids ppapi="" p missing others=0 others_ok=0 shown=0 more=0
        local inject_libs="libqq-wl-portal.so libqq-clipbridge.so libqq-screenshot.so libqq-borderfix.so"
        qqpids=$(pgrep -x qq 2>/dev/null)
        for p in $qqpids; do
            case "$(tr '\0' ' ' < "/proc/$p/cmdline" 2>/dev/null)" in
            *--type=ppapi*) ppapi="$p" ;;
            esac
        done
        missing_libs() {  # $1=pid → 打印缺的库（空 = 齐全）
            local m="" l g
            g=$(grep -ohE 'libqq-[a-z-]+\.so' "/proc/$1/maps" 2>/dev/null | sort -u)
            for l in $inject_libs; do
                printf '%s\n' "$g" | grep -qx "$l" || m="$m $l"
            done
            printf '%s' "$m"
        }
        if [[ -n "$ppapi" ]]; then
            missing=$(missing_libs "$ppapi")
            if [[ -z "$missing" ]]; then
                pass "收帧进程 ppapi（PID $ppapi）四个库齐全"
            elif ! grep -qs 'libqq-' "/proc/$ppapi/maps" 2>/dev/null; then
                bad "收帧进程 ppapi（PID $ppapi）没有任何注入库：共享会退回 QQ 自己的老实现"
            else
                note "收帧进程 ppapi（PID $ppapi）缺库：$missing"
            fi
        else
            note "没找到 --type=ppapi 进程（还没开始过共享？）"
        fi
        for p in $qqpids; do
            [[ "$p" == "$ppapi" || "$p" == "$pid" ]] && continue
            grep -qs 'libqq-' "/proc/$p/maps" 2>/dev/null || continue
            others=$((others + 1))
            missing=$(missing_libs "$p")
            if [[ -z "$missing" ]]; then
                others_ok=$((others_ok + 1))
            elif ((shown < 2)); then
                note "QQ 子进程（PID $p）缺库：$missing"
                shown=$((shown + 1))
            else
                more=$((more + 1))
            fi
        done
        ((others > 0)) && pass "另外 $others 个 QQ 子进程注入了库（$others_ok 个四个库齐全）"
        ((more > 0)) && note "另有 $more 个子进程也缺库（未逐条列出）"
    fi

    echo
    echo "[最近的 QQ 崩溃记录]"
    keep_crash_records
    local t
    t=$(ls -1t "$CRASH_KEEP"/tomb_*.txt 2>/dev/null | head -3)
    if [[ -z "$t" ]]; then
        pass "没有崩溃记录"
    else
        while read -r f; do
            note "$(date -r "$f" '+%F %T')  $f"
        done <<< "$t"
    fi

    echo
    if (( skipped > 0 )); then
        echo "通过 $ok，提醒 $warn，失败 $fail，跳过 $skipped。日志：$LOG"
    else
        echo "通过 $ok，提醒 $warn，失败 $fail。日志：$LOG"
    fi
    [[ $fail -eq 0 ]]
}

case "${1:-}" in
    --doctor) doctor; exit $? ;;
    --version)
        if [[ -n "$TEMPLATE_UNBUILT" ]]; then echo "linuxqq-wayland-fix （未构建模板）"; else echo "linuxqq-wayland-fix $VERSION"; fi
        exit 0 ;;
    --help|-h) sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    # 其余 -- 参数是刻意透传给 QQ 的（--use-gl/--use-angle/--force-device-scale-factor 等）。
    # 但把自检敲成 --docter 这类拼写错误时会静默启动 QQ，很容易误判成"自检没输出"，
    # 所以这里明确提示一次，行为不变。裸 "--"（约定：选项结束、后面都当参数）不提示。
    --?*)
        echo "linuxqq-wayland-fix: 不认识的参数 $1 —— 将原样传给 QQ（自检请用 --doctor）" >&2
        echo "      用法: linuxqq-wayland-fix [--doctor|--version|--help] [传给 QQ 的参数…]" >&2 ;;

esac

QQ=$(find_qq)
if [[ -z "$QQ" ]]; then
    echo "linuxqq-wayland-fix: 找不到 QQ（linuxqq 或 /opt/QQ/qq），可用 QQ_WAYLAND_FIX_QQ 指定" >&2
    exit 1
fi

preload=""
for lib in "$SCREENSHARE_LIB" "$CLIPBOARD_LIB" "$SCREENSHOT_LIB" "$BORDERFIX_LIB"; do
    [[ "$lib" == "$CLIPBOARD_LIB" ]] && clipboard_auto_disabled && continue
    [[ -r "$lib" ]] && preload="${preload:+$preload:}$lib"
done
export LD_PRELOAD="$preload${LD_PRELOAD:+:$LD_PRELOAD}"

# XDG_SESSION_TYPE=x11：让 QQ 界面与音视频 SDK 不拦截共享；
#   注入库只对 broadcast-core.so 改报 wayland，使它走自带的 portal + PipeWire 路径。
# MESA_SHADER_CACHE_DISABLE：QQ 的 libAVSDKPlugin 导出了自带的 ZSTD_* 符号，
#   会劫持 Mesa 着色器缓存的 zstd 解压，导致采集进程崩溃。
export XDG_SESSION_TYPE=x11
export MESA_SHADER_CACHE_DISABLE="${MESA_SHADER_CACHE_DISABLE:-true}"

angle_arg=()
case "$(angle_mode)" in
    vulkan) angle_arg=(--use-angle=vulkan) ;;
    swiftshader) angle_arg=(--use-angle=swiftshader) ;;
esac

keep_crash_records
{ echo "=== linuxqq-wayland-fix $VERSION $(date '+%F %T') $QQ $* angle=$(angle_mode) clipboard=$(clipboard_state)"; } >"$LOG" 2>/dev/null || LOG=/dev/null
exec "$QQ" --ozone-platform=wayland "${angle_arg[@]}" "$@" >>"$LOG" 2>&1
